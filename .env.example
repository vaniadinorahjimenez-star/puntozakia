# ==============================================================================
# PANADERÍA SANTA FÉ - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones de uso:
# 1. Copia este archivo y renómbralo como '.env' o '.env.local' en tu máquina local.
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. El archivo '.env' y '.env.local' están incluidos en .gitignore y NUNCA se subirán a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase Firestore (Vite Client)
# Obtenidos en la consola de Firebase: Configuración de Proyecto > General > Tus apps (Web)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-id"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="tu-base-datos-firestore"

# ------------------------------------------------------------------------------
# 2. Credenciales de Terminal de Cobro Clip Pinpad (Opcional)
# Obtenidos en tu panel de desarrollador Clip (developer.clip.mx)
# ------------------------------------------------------------------------------
VITE_CLIP_API_KEY="tu-clip-api-key"
VITE_CLIP_SECRET_KEY="tu-clip-secret-key"
VITE_CLIP_SERIAL="P8C2240805000156"

# ------------------------------------------------------------------------------
# 3. Asistente Inteligente Gemini (Inyectado por AI Studio en despliegue)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="TU_GEMINI_API_KEY"
APP_URL="https://tu-dominio.run.app"
